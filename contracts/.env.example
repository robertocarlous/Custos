# Required for any deploy (testnet or mainnet).
PRIVATE_KEY=

# --- Testnet (chain 46630) ---
# No extra config needed: Deploy.s.sol deploys its own mock sequencer feed and mock
# price feeds automatically, since Chainlink doesn't publish real ones on testnet,
# and configures OracleGuard against the real testnet faucet Stock Tokens
# (TSLA/AMZN/NFLX) hardcoded in the script.
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# --- Mainnet (chain 4663) only ---
# Real Chainlink infra exists on mainnet. Verify these yourself against
# https://docs.robinhood.com/chain/contracts/ and
# https://docs.chain.link/data-feeds/price-feeds/addresses?network=robinhood
# before deploying -- never trust a hardcoded mainnet address blindly.
SEQUENCER_UPTIME_FEED=
MAINNET_TOKENS=
MAINNET_FEEDS=
SEQUENCER_GRACE_PERIOD=3600

EXPLORER_API_URL=https://explorer.testnet.chain.robinhood.com/api
EXPLORER_API_KEY=
